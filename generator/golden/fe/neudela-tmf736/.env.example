# Copy to .env.local (git-ignored) and adjust.

# Base URL prepended to /tmf-api/... calls. Empty = same origin, which the Vite
# dev server proxies to API_PROXY_TARGET.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /tmf-api (the TMF736 backend). Read by vite.config.ts only.
API_PROXY_TARGET=http://localhost:3736

# Sent as X-API-Key when set.
VITE_API_KEY=

# Policy Management service backing the relation pickers. Unset = pickers explain that it is not connected.
VITE_POLICY_API_BASE_URL=
