# revenue-sharing-algorithm-service - copy to .env and fill in real values.
# Generated by tmfgen. Never commit a filled-in .env.

# PORT defaults to this component's identity port ('3' + TMF number).
# Override per-environment as needed.
PORT=3901
CORS_ORIGIN=*

# development | production. In production the Swagger UI URL is not logged on boot.
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────
# sqlite (default, zero-setup dev) or postgres - MUST match the --database
# flag used to generate this service (column types are baked in, not runtime).
DATABASE_TYPE=sqlite
DATABASE_PATH=./dev.db
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# postgres - set automatically when generated with --database postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=revenue_sharing_algorithm

# ── Auth ──────────────────────────────────────────────────────────────
# SKIP_AUTH=true bypasses ApiKeyGuard; leave true for local dev only.
SKIP_AUTH=true
API_KEY=

# ── Messaging (publish-only) ──────────────────────────────────────────
# Leave blank to run without a broker: connection failure is logged and retried,
# so the service still boots.
RABBITMQ_URL=
RABBITMQ_RECONNECT_DELAY_MS=5000
