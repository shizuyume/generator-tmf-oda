{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmfgen.local/schemas/neudela-fe.schema.json",
  "title": "neudela-fe/v1 spec (neudela adapter, Vite)",
  "description": "Spec of an app generated by the neudela adapter. `app` is the per-app data the emitter (src/fe/neudela/emitApp.mjs) writes out; `template` / `generation` default to templates/fe-neudela/template.yaml. Page configs follow src/resource/types.ts of the template (ResourceConfig).",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "app"
  ],
  "properties": {
    "apiVersion": {
      "const": "neudela-fe/v1"
    },
    "kind": {
      "enum": [
        "FrontendTemplate",
        "FrontendApp"
      ]
    },
    "meta": {
      "type": "object"
    },
    "generation": {
      "type": "object"
    },
    "template": {
      "type": "object"
    },
    "knownGaps": {
      "type": "array"
    },
    "verification": {
      "type": "object"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meta",
        "brand",
        "api",
        "environment",
        "navigation",
        "services",
        "lookups",
        "schemas",
        "pages",
        "mock"
      ],
      "properties": {
        "meta": {
          "type": "object",
          "required": [
            "name",
            "packageName",
            "version",
            "uiLang",
            "title",
            "description",
            "packageDescription",
            "favicon",
            "typesFile"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "packageName": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "uiLang": {
              "enum": [
                "en"
              ]
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "packageDescription": {
              "type": "string"
            },
            "favicon": {
              "type": "object",
              "required": [
                "href",
                "type"
              ]
            },
            "typesFile": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
            }
          }
        },
        "tmf": {
          "type": "object",
          "required": [
            "number",
            "specTitle",
            "specVersion"
          ],
          "properties": {
            "number": {
              "type": "string"
            },
            "specTitle": {
              "type": "string"
            },
            "specVersion": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "oas": {
              "type": "string"
            }
          }
        },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logoLetter",
            "title",
            "caption"
          ],
          "properties": {
            "logoLetter": {
              "type": "string",
              "maxLength": 2
            },
            "title": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          }
        },
        "api": {
          "type": "object",
          "required": [
            "basePath",
            "authHeader"
          ],
          "properties": {
            "basePath": {
              "type": "string",
              "pattern": "^/"
            },
            "authHeader": {
              "type": "string"
            }
          }
        },
        "environment": {
          "type": "object",
          "required": [
            "port",
            "apiProxyTargetDefault",
            "lookupMockBase",
            "variables",
            "mock"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "apiProxyTargetDefault": {
              "type": "string"
            },
            "lookupMockBase": {
              "type": "string",
              "pattern": "^/"
            },
            "variables": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/envVar"
              }
            },
            "mock": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value"
                ]
              }
            }
          }
        },
        "navigation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "label",
              "icon",
              "page"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*Service$"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "type": {
                "type": "string"
              },
              "create": {
                "type": "string"
              },
              "update": {
                "type": "string"
              },
              "nested": {
                "type": "boolean",
                "description": "path holds the parent id ({param}): the service is bound per parent record"
              }
            }
          }
        },
        "lookups": {
          "type": "object",
          "required": [
            "apis",
            "items"
          ],
          "properties": {
            "apis": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "service",
                  "baseUrlEnv",
                  "basePath",
                  "queryParam",
                  "limit",
                  "labelField",
                  "valueField"
                ],
                "properties": {
                  "service": {
                    "type": "string"
                  },
                  "baseUrlEnv": {
                    "type": "string",
                    "pattern": "^VITE_[A-Z0-9_]+$"
                  },
                  "basePath": {
                    "type": "string"
                  },
                  "queryParam": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "labelField": {
                    "type": "string"
                  },
                  "valueField": {
                    "type": "string"
                  },
                  "unresolved": {
                    "type": "boolean"
                  }
                }
              }
            },
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "api",
                  "path",
                  "noun",
                  "ref"
                ],
                "properties": {
                  "api": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "noun": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/schema"
          }
        },
        "errorResponses": {
          "type": "object"
        },
        "operations": {
          "type": "object"
        },
        "events": {
          "type": "array"
        },
        "pages": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/overviewPage"
              },
              {
                "$ref": "#/$defs/resourcePage"
              }
            ]
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "overrides": {
              "type": "object",
              "properties": {
                "light": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "dark": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "mock": {
          "type": "object",
          "required": [
            "latencyMs",
            "lookups",
            "resources"
          ],
          "properties": {
            "latencyMs": {
              "type": "integer",
              "minimum": 0
            },
            "lookups": {
              "type": "object"
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "label",
                  "items",
                  "rules",
                  "patch",
                  "timestamps"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "label": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array"
                  },
                  "rules": {
                    "type": "array"
                  },
                  "patch": {
                    "type": "boolean"
                  },
                  "timestamps": {
                    "type": "boolean"
                  },
                  "createFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "type": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "comment"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "schema": {
      "type": "object",
      "required": [
        "kind",
        "properties"
      ],
      "properties": {
        "kind": {
          "enum": [
            "resource",
            "ref",
            "entry",
            "hub",
            "error"
          ]
        },
        "properties": {
          "type": "object"
        },
        "shapes": {
          "type": "object"
        }
      }
    },
    "iconRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "icon",
        "size"
      ],
      "properties": {
        "icon": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 48
        }
      }
    },
    "expr": {
      "type": "object",
      "minProperties": 1,
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "pick"
          ]
        },
        {
          "required": [
            "count"
          ]
        },
        {
          "required": [
            "join"
          ]
        },
        {
          "required": [
            "dateTime"
          ]
        },
        {
          "required": [
            "relativeTime"
          ]
        },
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "ifAny"
          ]
        },
        {
          "required": [
            "plural"
          ]
        },
        {
          "required": [
            "format"
          ]
        },
        {
          "required": [
            "parts"
          ]
        },
        {
          "required": [
            "sumCount"
          ]
        },
        {
          "required": [
            "yesNo"
          ]
        },
        {
          "required": [
            "oneOf"
          ]
        }
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "render"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 32
        },
        "sortable": {
          "type": "boolean"
        },
        "render": {
          "enum": [
            "id-link",
            "primary",
            "primary-plain",
            "ellipsis",
            "mono",
            "mono-muted",
            "mono-plain",
            "count-badge",
            "datetime-stack",
            "ref-stack"
          ]
        },
        "value": {
          "$ref": "#/$defs/expr"
        },
        "empty": {
          "oneOf": [
            {
              "const": "em-dash"
            },
            {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "badge": {
          "type": "object",
          "required": [
            "icon",
            "one",
            "many"
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "url",
            "textarea",
            "boolean",
            "date",
            "enum",
            "number",
            "json",
            "ref",
            "group",
            "repeatable"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        }
      }
    },
    "overviewPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "const": "overview"
        },
        "summary": {
          "type": "object",
          "required": [
            "apiInfo",
            "resources",
            "operations",
            "events",
            "primaryResourceNoun",
            "countService"
          ]
        }
      }
    },
    "resourcePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dir",
        "component",
        "comment",
        "expose",
        "service",
        "lookups",
        "config"
      ],
      "properties": {
        "kind": {
          "const": "resource"
        },
        "dir": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "comment": {
          "type": "string"
        },
        "expose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "file",
            "pageName"
          ],
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^\\./"
            },
            "file": {
              "type": "string"
            },
            "pageName": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "string"
        },
        "lookups": {
          "type": "boolean"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "list"
          ],
          "properties": {
            "list": {
              "type": "object",
              "required": [
                "breadcrumb",
                "title",
                "subtitle",
                "card",
                "rowFrom",
                "columns",
                "sortOptions",
                "filterFields",
                "rowActions",
                "mobileCard"
              ],
              "properties": {
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/column"
                  }
                },
                "card": {
                  "type": "object",
                  "required": [
                    "title",
                    "noun",
                    "minTableWidth",
                    "buttonActionVariant",
                    "rowLabel",
                    "searchPlaceholder",
                    "searchParam",
                    "emptyTitle",
                    "emptyBody",
                    "refresh",
                    "rowClick"
                  ],
                  "properties": {
                    "buttonActionVariant": {
                      "enum": [
                        "inline",
                        "menu"
                      ]
                    },
                    "rowClick": {
                      "enum": [
                        "open-detail",
                        "none"
                      ]
                    },
                    "primaryAction": {
                      "type": "object",
                      "required": [
                        "label",
                        "icon"
                      ],
                      "properties": {
                        "icon": {
                          "$ref": "#/$defs/iconRef"
                        }
                      }
                    }
                  }
                },
                "rowActions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "label",
                      "ariaLabel",
                      "icon",
                      "tone",
                      "action"
                    ],
                    "properties": {
                      "icon": {
                        "$ref": "#/$defs/iconRef"
                      },
                      "tone": {
                        "enum": [
                          "brand",
                          "neutral",
                          "danger"
                        ]
                      },
                      "action": {
                        "enum": [
                          "open-detail",
                          "open-edit",
                          "confirm-delete"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "form": {
              "type": "object",
              "required": [
                "formId",
                "width",
                "title",
                "description",
                "submitLabel",
                "validateOn",
                "fields",
                "guard",
                "payload",
                "toast"
              ],
              "properties": {
                "width": {
                  "enum": [
                    "wide",
                    "narrow"
                  ]
                },
                "validateOn": {
                  "enum": [
                    "submit",
                    "touched"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/field"
                  }
                },
                "payload": {
                  "type": "object"
                },
                "edit": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "formId",
                    "title",
                    "description",
                    "submitLabel",
                    "fields",
                    "payload",
                    "toast",
                    "noChanges"
                  ],
                  "properties": {
                    "formId": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "submitLabel": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "payload": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "toast": {
                      "type": "string"
                    },
                    "noChanges": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "detail": {
              "type": "object",
              "required": [
                "idPrefix",
                "tabsAriaLabel",
                "breadcrumbRoot",
                "header",
                "loadingText",
                "notFound",
                "tabs",
                "overview",
                "collections"
              ]
            }
          }
        }
      }
    }
  }
}
